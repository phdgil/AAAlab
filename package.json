{
  "name": "aaalab-harnesses",
  "version": "0.2.0",
  "description": "AAAlab agent harness installer and validator.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phdgil/AAAlab.git"
  },
  "bin": {
    "aaalab": "bin/aaalab.js"
  },
  "scripts": {
    "test": "node bin/aaalab.js validate && node scripts/test-qsar-skills.js",
    "validate": "node bin/aaalab.js validate",
    "runtime-check": "node bin/aaalab.js runtime-check autodock-vina-harness",
    "runtime-check:openmra": "node bin/aaalab.js runtime-check openmra-harness",
    "test:qsar-native": "python scripts/test_qsar_native_agents.py",
    "test:qsar-runtime": "python scripts/test_qsar_runtime.py",
    "test:qsar-python": "python -m unittest discover -s scripts -p test_qsar_*.py"
  },
  "files": [
    "assets",
    "bin",
    "harnesses",
    "scripts",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  }
}
